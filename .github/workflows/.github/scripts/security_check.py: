#!/usr/bin/env python3

from pathlib import Path
import re
import sys

IGNORED_DIRECTORIES = {
    ".git",
    ".venv",
    "venv",
    "node_modules",
    "vendor",
    "dist",
    "build",
}

TEXT_EXTENSIONS = {
    ".py",
    ".js",
    ".ts",
    ".jsx",
    ".tsx",
    ".sh",
    ".ps1",
    ".yml",
    ".yaml",
    ".json",
    ".env",
    ".ini",
    ".toml",
    ".xml",
    ".properties",
}

MAX_FILE_SIZE = 1_000_000

RULES = {
    "Chave privada": re.compile(
        r"-----BEGIN (?:RSA |EC |OPENSSH )?PRIVATE KEY-----"
    ),
    "Token do GitHub": re.compile(
        r"\b(?:ghp|gho|ghu|ghs|ghr)_[A-Za-z0-9]{20,}\b"
    ),
    "Token clássico do GitHub": re.compile(
        r"\bgithub_pat_[A-Za-z0-9_]{20,}\b"
    ),
    "Chave da AWS": re.compile(
        r"\bAKIA[0-9A-Z]{16}\b"
    ),
    "Comando shell potencialmente perigoso": re.compile(
        r"(?:curl|wget)\s+[^|\n]+\|\s*(?:bash|sh)\b",
        re.IGNORECASE,
    ),
    "Execução dinâmica em Python": re.compile(
        r"\b(?:eval|exec)\s*\("
    ),
}


def should_scan(path: Path) -> bool:
    if any(part in IGNORED_DIRECTORIES for part in path.parts):
        return False

    if not path.is_file():
        return False

    if path.stat().st_size > MAX_FILE_SIZE:
        return False

    return path.suffix.lower() in TEXT_EXTENSIONS or path.name.startswith(".env")


def redact(value: str) -> str:
    value = value.strip()

    if len(value) <= 8:
        return "[oculto]"

    return f"{value[:4]}...{value[-4:]}"


def scan_file(path: Path) -> list[str]:
    findings = []

    try:
        content = path.read_text(encoding="utf-8", errors="ignore")
    except OSError as error:
        return [f"{path}: erro de leitura: {error}"]

    for line_number, line in enumerate(content.splitlines(), start=1):
        for rule_name, pattern in RULES.items():
            match = pattern.search(line)

            if match:
                findings.append(
                    f"{path}:{line_number}: {rule_name}: "
                    f"{redact(match.group(0))}"
                )

    return findings


def main() -> int:
    findings = []

    for path in Path(".").rglob("*"):
        if should_scan(path):
            findings.extend(scan_file(path))

    if findings:
        print("Falha na verificação de segurança:\n")

        for finding in findings:
            print(f"::error::{finding}")

        print(f"\nTotal de ocorrências: {len(findings)}")
        return 1

    print("Nenhuma ocorrência suspeita encontrada.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
